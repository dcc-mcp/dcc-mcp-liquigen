prune .artifacts
prune dist
prune work
prune videos
global-exclude *.png *.jpg *.jpeg *.webp *.ico
global-exclude *.dll *.exe *.pdb *.lib *.obj *.exp
global-exclude *.liquigen *.fbx *.exr *.vdb *.abc *.uasset *.umap
