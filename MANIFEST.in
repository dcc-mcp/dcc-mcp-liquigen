include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include install.md
include justfile
include vx.toml
recursive-include docs *.md
recursive-include packaging *.ps1
recursive-include examples *.ini *.md *.py *.uproject
recursive-include native CMakeLists.txt *.cpp *.h *.json *.md
